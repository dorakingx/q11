{
  "name": "q11-quantum-emergency-response",
  "private": true,
  "version": "0.1.0",
  "description": "Q11 — Quantum Emergency Response: a fire-dispatch game about Pauli error propagation and stabilizer error correction (Qollab x IonQ Hackathon 2026)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "verify:quantum": "node scripts/verify-quantum.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "build:qollab": "node scripts/build-qollab.mjs",
    "check:protection": "node scripts/check-protection.mjs",
    "preview:qollab": "node scripts/serve-qollab-harness.mjs",
    "record:demo": "node scripts/record-demo.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  }
}
